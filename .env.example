# Odoo Fast MCP Configuration
# Copy this file to .env and adjust values

# Odoo server URL (required)
ODOO_URL=http://localhost:8069

# Database name (required)
ODOO_DATABASE=mydb

# Authentication credentials (required)
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Connection timeout in seconds (optional, default: 30)
ODOO_TIMEOUT=30

# =============================================================================
# MCP Transport Configuration (optional)
# =============================================================================

# Transport protocol: stdio (default), http (Streamable HTTP), or sse
# MCP_TRANSPORT=stdio

# Host to bind HTTP/SSE server to (default: 0.0.0.0)
# MCP_HOST=0.0.0.0

# Port for HTTP/SSE server (default: 8000)
# MCP_PORT=8000
